<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AndroidRssReader.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:AndroidRssReader.Models"
    xmlns:vm="clr-namespace:AndroidRssReader.ViewModels"
    x:DataType="vm:MainViewModel"
    Title="Main"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  Header  -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,1">
            <Grid
                Padding="16,14,8,10"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12">
                <Image
                    Grid.Column="0"
                    WidthRequest="24"
                    HeightRequest="24"
                    Aspect="AspectFit"
                    Opacity="0.85"
                    Source="rss"
                    VerticalOptions="Center" />
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="1"
                    VerticalOptions="Center">
                    <Label
                        FontFamily="Roboto-Medium"
                        FontSize="22"
                        LineBreakMode="TailTruncation"
                        Text="{Binding HeaderTitle}"
                        TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                    Dark={StaticResource OnSurfaceDark}}" />
                    <Label
                        FontSize="12"
                        LineBreakMode="TailTruncation"
                        Text="{Binding Subtitle}"
                        TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight},
                                                    Dark={StaticResource OnSurfaceVariantDark}}" />
                </VerticalStackLayout>
            </Grid>

            <Label
                Grid.Row="1"
                Padding="16,0,16,10"
                FontSize="12"
                IsVisible="{Binding HasStatus}"
                LineBreakMode="WordWrap"
                Text="{Binding StatusText}"
                TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight},
                                            Dark={StaticResource OnSurfaceVariantDark}}">
                <Label.Triggers>
                    <DataTrigger
                        Binding="{Binding IsStatusError}"
                        TargetType="Label"
                        Value="True">
                        <Setter Property="TextColor" Value="#E5534B" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <BoxView
                Grid.Row="2"
                Color="{AppThemeBinding Light={StaticResource OutlineVariantLight},
                                        Dark={StaticResource OutlineVariantDark}}"
                Opacity="0.5" />
        </Grid>

        <!--  Articles  -->
        <Grid Grid.Row="1">
            <RefreshView
                Command="{Binding RefreshCommand}"
                IsRefreshing="{Binding IsRefreshing}">
                <CollectionView
                    ItemSizingStrategy="MeasureAllItems"
                    ItemsSource="{Binding Articles}"
                    SelectionChanged="OnArticleSelected"
                    SelectionMode="Single">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Article">
                            <Grid
                                Padding="16,13"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="10"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="5">
                                <!--
                                    An article that was opened stays in the list, so its title is
                                    drawn in a light grey without a bold weight to show that it is
                                    read already.
                                -->
                                <Label
                                    FontSize="16"
                                    LineHeight="1.2"
                                    Text="{Binding TitleText}"
                                    TextColor="{AppThemeBinding Light={StaticResource ReadTitleLight},
                                                                Dark={StaticResource ReadTitleDark}}">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsUnread}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="FontAttributes" Value="Bold" />
                                            <Setter
                                                Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                        Dark={StaticResource OnSurfaceDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <BoxView
                                    Grid.Column="1"
                                    WidthRequest="8"
                                    HeightRequest="8"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight},
                                                       Dark={StaticResource PrimaryDark}}"
                                    CornerRadius="4"
                                    IsVisible="{Binding IsUnread}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontSize="12"
                                    HorizontalTextAlignment="End"
                                    Text="{Binding AgeText}"
                                    TextColor="{AppThemeBinding Light={StaticResource FeedMetaLight},
                                                               Dark={StaticResource FeedMetaDark}}" />
                                <Label
                                    Grid.Row="1"
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{Binding MetaText}"
                                    TextColor="{AppThemeBinding Light={StaticResource FeedMetaLight},
                                                               Dark={StaticResource FeedMetaDark}}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="32,64,32,32" Spacing="10">
                            <Image
                                WidthRequest="52"
                                HeightRequest="52"
                                HorizontalOptions="Center"
                                Opacity="0.4"
                                Source="rss" />
                            <Label
                                FontFamily="Roboto-Medium"
                                FontSize="18"
                                HorizontalTextAlignment="Center"
                                Text="No articles to show" />
                            <Label
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding ShowImportPrompt}"
                                Text="Import an OPML file exported from your current feed reader, then pull down to download the articles."
                                TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight},
                                                            Dark={StaticResource OnSurfaceVariantDark}}" />
                            <Label
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding HasSubscriptions}"
                                Text="Pull down to refresh, or choose “Show read and unread” in the menu to see the articles you already read."
                                TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight},
                                                            Dark={StaticResource OnSurfaceVariantDark}}" />
                            <Button
                                Margin="0,10,0,0"
                                Clicked="OnImportOpmlClicked"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ShowImportPrompt}"
                                Text="Import OPML file" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!--  Bottom toolbar  -->
        <Grid Grid.Row="2" RowDefinitions="1,Auto">
            <BoxView
                Grid.Row="0"
                Color="{AppThemeBinding Light={StaticResource OutlineVariantLight},
                                        Dark={StaticResource OutlineVariantDark}}"
                Opacity="0.5" />
            <Grid
                Grid.Row="1"
                Padding="8,4"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerLowLight},
                                                   Dark={StaticResource SurfaceContainerLowDark}}"
                ColumnDefinitions="*,*,*">
                <ImageButton
                    Grid.Column="0"
                    WidthRequest="48"
                    HeightRequest="48"
                    Aspect="AspectFit"
                    BackgroundColor="Transparent"
                    Clicked="OnMoreClicked"
                    HorizontalOptions="Center"
                    Padding="12"
                    SemanticProperties.Description="More options"
                    Source="more_horiz" />
                <ImageButton
                    Grid.Column="1"
                    WidthRequest="48"
                    HeightRequest="48"
                    Aspect="AspectFit"
                    BackgroundColor="Transparent"
                    Clicked="OnMarkAllReadClicked"
                    HorizontalOptions="Center"
                    Padding="12"
                    SemanticProperties.Description="Mark all as read"
                    Source="check" />
                <ImageButton
                    Grid.Column="2"
                    WidthRequest="48"
                    HeightRequest="48"
                    Aspect="AspectFit"
                    BackgroundColor="Transparent"
                    Clicked="OnRefreshLatestClicked"
                    HorizontalOptions="Center"
                    Padding="12"
                    SemanticProperties.Description="Refresh the feeds and show the unread articles"
                    Source="refresh" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
